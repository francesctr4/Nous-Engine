{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "profiling-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_PROFILING": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "Debug-Windows",
      "displayName": "Debug-Windows",
      "inherits": [ "debug-base", "windows-base" ]
    },
    {
      "name": "Profiling-Windows",
      "displayName": "Profiling-Windows",
      "inherits": [ "profiling-base", "windows-base" ]
    },
    {
      "name": "Release-Windows",
      "displayName": "Release-Windows",
      "description": "Optimized build WITH symbols. /Zi and /DEBUG cost nothing at runtime (the PDB is a separate file and the code is unchanged) and are what make the minidumps written by CrashHandler readable -- without them a dump is the same wall of bare addresses as no dump at all. /OPT:REF and /OPT:ICF are restated because /DEBUG otherwise turns them off, which would silently make this build bigger and slower than Release is supposed to be.",
      "inherits": [ "release-base", "windows-base" ],
      "cacheVariables": {
        "CMAKE_C_FLAGS_RELEASE": "/MD /O2 /Ob2 /DNDEBUG /Zi",
        "CMAKE_CXX_FLAGS_RELEASE": "/MD /O2 /Ob2 /DNDEBUG /Zi",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/DEBUG /OPT:REF /OPT:ICF",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/DEBUG /OPT:REF /OPT:ICF"
      }
    },
    {
      "name": "Debug-Linux",
      "displayName": "Debug-Linux",
      "inherits": "debug-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "Profiling-Linux",
      "displayName": "Profiling-Linux",
      "inherits": "profiling-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "Release-Linux",
      "displayName": "Release-Linux",
      "description": "Optimized build WITH symbols. -g costs nothing at runtime and is what makes the core files CrashHandler re-raises for actually readable; without it a core is a wall of bare addresses. Mirrors Release-Windows, which carries /Zi for the same reason.",
      "inherits": "release-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -g",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -g"
      }
    },
    {
      "name": "ASan-Linux",
      "displayName": "ASan-Linux (address+undefined)",
      "inherits": "debug-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "NOUS_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "TSan-Linux",
      "displayName": "TSan-Linux (thread)",
      "inherits": "debug-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "NOUS_SANITIZE": "thread"
      }
    },
    {
      "name": "Debug-macOS",
      "displayName": "Debug-macOS",
      "inherits": "debug-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "Profiling-macOS",
      "displayName": "Profiling-macOS",
      "inherits": "profiling-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "Release-macOS",
      "displayName": "Release-macOS",
      "description": "Optimized build WITH symbols, mirroring Release-Windows and Release-Linux. Note that macOS writes cores to /cores only when that directory exists and is writable, and a hardened/signed binary will not dump at all -- the backtrace CrashHandler prints is the reliable artifact there.",
      "inherits": "release-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -g",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -g"
      }
    }
  ]
}