# Rectangle quad — 16:9 (1.7778x1 units), centered at origin, facing +Z
# UVs span U:0->4, V:0->2.25 so each checker cell is square on a 16:9 surface.
# Two triangles (CCW winding).

v -0.8889  0.5  0.0
v -0.8889 -0.5  0.0
v  0.8889 -0.5  0.0
v  0.8889  0.5  0.0

vt  0.0   2.25
vt  0.0   0.0
vt  4.0   0.0
vt  4.0   2.25

vn 0.0 0.0 1.0

# tri 1: top-left, bottom-left, bottom-right
f 1/1/1  2/2/1  3/3/1
# tri 2: top-left, bottom-right, top-right
f 1/1/1  3/3/1  4/4/1
