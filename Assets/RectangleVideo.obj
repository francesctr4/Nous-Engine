# Rectangle quad — 16:9 (1.7778x1 units), centered at origin, facing +Z
# UVs span U:0->1, V:0->1 so a texture (e.g. a video frame) maps exactly once (no tiling).
# Two triangles (CCW winding). Same geometry/orientation as Rectangle.obj.

v -0.8889  0.5  0.0
v -0.8889 -0.5  0.0
v  0.8889 -0.5  0.0
v  0.8889  0.5  0.0

vt  0.0  1.0
vt  0.0  0.0
vt  1.0  0.0
vt  1.0  1.0

vn 0.0 0.0 1.0

# tri 1: top-left, bottom-left, bottom-right
f 1/1/1  2/2/1  3/3/1
# tri 2: top-left, bottom-right, top-right
f 1/1/1  3/3/1  4/4/1
