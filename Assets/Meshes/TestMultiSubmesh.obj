# TestMultiSubmesh.obj
# Three separate named submeshes (unit cubes) at X = -2, 0, +2.
# NOTE: OBJ format bakes vertex positions into world space — there are no
# per-object node transforms.  Assimp will return identity transforms for every
# 'o' group, so each child GO's CTransform.position will be (0,0,0) even though
# the mesh vertices are at their world positions.  The gizmo will therefore appear
# at the world origin for all three children, NOT at each cube center.
# This is an OBJ format limitation.  FBX files with real node hierarchies will
# produce the correct gizmo placement.
#
# Expected result when dropped into the scene viewport:
#   Root GO "TestMultiSubmesh"
#     Child "CubeA"  (unit cube centred at X = -2)
#     Child "CubeB"  (unit cube centred at X =  0)
#     Child "CubeC"  (unit cube centred at X = +2)

# ── Shared normals ─────────────────────────────────────────────────────────────
vn  0.0  0.0  1.0   # 1 front  (+Z)
vn  0.0  0.0 -1.0   # 2 back   (-Z)
vn  0.0  1.0  0.0   # 3 top    (+Y)
vn  0.0 -1.0  0.0   # 4 bottom (-Y)
vn  1.0  0.0  0.0   # 5 right  (+X)
vn -1.0  0.0  0.0   # 6 left   (-X)

# ── Shared UVs (simple quad layout) ───────────────────────────────────────────
vt  0.0  0.0   # 1
vt  1.0  0.0   # 2
vt  1.0  1.0   # 3
vt  0.0  1.0   # 4

# ==============================================================================
# CubeA  — centred at (-2, 0, 0)
# ==============================================================================
o CubeA
v -2.5 -0.5 -0.5   #  1
v -1.5 -0.5 -0.5   #  2
v -1.5  0.5 -0.5   #  3
v -2.5  0.5 -0.5   #  4
v -2.5 -0.5  0.5   #  5
v -1.5 -0.5  0.5   #  6
v -1.5  0.5  0.5   #  7
v -2.5  0.5  0.5   #  8

# Front (+Z)
f  5/1/1  6/2/1  7/3/1
f  5/1/1  7/3/1  8/4/1
# Back (-Z)
f  2/1/2  1/2/2  4/3/2
f  2/1/2  4/3/2  3/4/2
# Top (+Y)
f  8/1/3  7/2/3  3/3/3
f  8/1/3  3/3/3  4/4/3
# Bottom (-Y)
f  1/1/4  2/2/4  6/3/4
f  1/1/4  6/3/4  5/4/4
# Right (+X)
f  6/1/5  2/2/5  3/3/5
f  6/1/5  3/3/5  7/4/5
# Left (-X)
f  1/1/6  5/2/6  8/3/6
f  1/1/6  8/3/6  4/4/6

# ==============================================================================
# CubeB  — centred at (0, 0, 0)
# ==============================================================================
o CubeB
v -0.5 -0.5 -0.5   #  9
v  0.5 -0.5 -0.5   # 10
v  0.5  0.5 -0.5   # 11
v -0.5  0.5 -0.5   # 12
v -0.5 -0.5  0.5   # 13
v  0.5 -0.5  0.5   # 14
v  0.5  0.5  0.5   # 15
v -0.5  0.5  0.5   # 16

# Front (+Z)
f 13/1/1 14/2/1 15/3/1
f 13/1/1 15/3/1 16/4/1
# Back (-Z)
f 10/1/2  9/2/2 12/3/2
f 10/1/2 12/3/2 11/4/2
# Top (+Y)
f 16/1/3 15/2/3 11/3/3
f 16/1/3 11/3/3 12/4/3
# Bottom (-Y)
f  9/1/4 10/2/4 14/3/4
f  9/1/4 14/3/4 13/4/4
# Right (+X)
f 14/1/5 10/2/5 11/3/5
f 14/1/5 11/3/5 15/4/5
# Left (-X)
f  9/1/6 13/2/6 16/3/6
f  9/1/6 16/3/6 12/4/6

# ==============================================================================
# CubeC  — centred at (+2, 0, 0)
# ==============================================================================
o CubeC
v  1.5 -0.5 -0.5   # 17
v  2.5 -0.5 -0.5   # 18
v  2.5  0.5 -0.5   # 19
v  1.5  0.5 -0.5   # 20
v  1.5 -0.5  0.5   # 21
v  2.5 -0.5  0.5   # 22
v  2.5  0.5  0.5   # 23
v  1.5  0.5  0.5   # 24

# Front (+Z)
f 21/1/1 22/2/1 23/3/1
f 21/1/1 23/3/1 24/4/1
# Back (-Z)
f 18/1/2 17/2/2 20/3/2
f 18/1/2 20/3/2 19/4/2
# Top (+Y)
f 24/1/3 23/2/3 19/3/3
f 24/1/3 19/3/3 20/4/3
# Bottom (-Y)
f 17/1/4 18/2/4 22/3/4
f 17/1/4 22/3/4 21/4/4
# Right (+X)
f 22/1/5 18/2/5 19/3/5
f 22/1/5 19/3/5 23/4/5
# Left (-X)
f 17/1/6 21/2/6 24/3/6
f 17/1/6 24/3/6 20/4/6
